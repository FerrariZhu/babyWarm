# Docker containers use the host network on Ubuntu, so the host PostgreSQL is
# reachable through 127.0.0.1. Keep the real value only in .env.production.
DATABASE_URL=postgresql://warmrobot_app:replace-with-url-encoded-password@127.0.0.1:5432/warmrobot
# Optional production override for the public Web service. This lets the admin
# service retain a separate migration connection while Web uses least privilege.
WEB_DATABASE_URL=postgresql://warmrobot_app:replace-with-url-encoded-password@127.0.0.1:5432/warmrobot
DATABASE_SSL=false

# 微信小程序服务端凭证。AppSecret 只保存在服务器的 .env.production。
WECHAT_APP_ID=replace-with-mini-program-app-id
WECHAT_APP_SECRET=replace-with-mini-program-app-secret

SELF_HOSTED_ADMIN_EMAILS=admin@example.com

# Public URLs shown by the two Next.js apps. Replace before building the image.
NEXT_PUBLIC_WEB_APP_URL=https://your-domain.example
NEXT_PUBLIC_ADMIN_URL=https://admin.your-domain.example
