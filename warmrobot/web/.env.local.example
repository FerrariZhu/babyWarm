# 云服务器 PostgreSQL。生产环境使用独立的最小权限账号。
WEB_DATABASE_URL=postgresql://warmrobot_app:replace-me@127.0.0.1:5432/warmrobot
DATABASE_SSL=false

# 配置后台地址（C 端 /admin/* 会 307 跳转至此；本地默认 3001）
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# 微信小程序（服务端 code→openid，并签发应用自有会话）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# 服务端图片持久化目录（Docker 部署默认通过 volume 挂载）
# GUIDE_ASSET_DIR=/var/lib/warmrobot/guide-assets

# ══════════════════════════════════════════════════════════════
# 以下仅历史衣橱实验代码需要（不参与构建或生产运行）
# 见 web/src/legacy-wardrobe/README.md
# ══════════════════════════════════════════════════════════════

# 万邦 OneBound item_get（粘贴淘宝/天猫链接解析）
# ONEBOUND_API_KEY=your-key
# ONEBOUND_API_SECRET=your-secret

# 视觉识别 / 美化（硅基流动）
# VISION_PROVIDER=openai_compat
# VISION_API_KEY=sk-...
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# BEAUTIFY_ENABLED=auto
# BEAUTIFY_MODEL=Qwen/Qwen-Image-Edit-2509
