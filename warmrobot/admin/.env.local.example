# 云服务器 PostgreSQL（后台所有数据、登录与会话必填；勿提交 git）
DATABASE_URL=postgresql://warmrobot_app:replace-me@127.0.0.1:5432/warmrobot
DATABASE_SSL=false

# 配置后台必填（勿提交 git）
# 仅这些 app_accounts 邮箱可登录配置后台（逗号分隔）
ADMIN_EMAILS=your-login-email@example.com
# 可选：仅本地自托管预览补充的管理员邮箱（不会覆盖 ADMIN_EMAILS）
SELF_HOSTED_ADMIN_EMAILS=

# 云服务器持久化图片目录（Web 与 Admin 必须挂载同一目录）
GUIDE_ASSET_DIR=/var/lib/warmrobot/guide-assets

# 可选：C 端地址（顶栏「返回 C 端」链接，默认 http://localhost:3000）
# NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
